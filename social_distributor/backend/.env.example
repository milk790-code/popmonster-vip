# Core
FLASK_ENV=development
SECRET_KEY=replace-with-32+byte-random-string
TOKEN_ENCRYPTION_KEY=replace-with-fernet-key

# Database / cache
DATABASE_URL=postgresql+psycopg2://distributor:distributor@db:5432/distributor
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# OAuth - Facebook / Instagram (Meta)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/auth/meta/callback

# OAuth - TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:5000/auth/tiktok/callback

# OAuth - YouTube (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/youtube/callback

# Compliance APIs
PERSPECTIVE_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Notifications
SENDGRID_API_KEY=
NOTIFY_EMAIL_FROM=alerts@example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Behaviour
PUBLISH_DEFAULT_TIMEZONE=UTC
RETRY_MAX_ATTEMPTS=5
RETRY_BACKOFF_BASE_SECONDS=30
