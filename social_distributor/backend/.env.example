# Core
FLASK_ENV=development
SECRET_KEY=replace-with-32+byte-random-string
TOKEN_ENCRYPTION_KEY=replace-with-fernet-key

# Database / cache
DATABASE_URL=postgresql+psycopg2://distributor:distributor@db:5432/distributor
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# OAuth - Facebook / Instagram (Meta)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/auth/meta/callback

# OAuth - TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:5000/auth/tiktok/callback

# OAuth - YouTube (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/youtube/callback

# Compliance APIs
PERSPECTIVE_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Object storage for uploaded media (S3 or any S3-compatible: R2, MinIO)
MEDIA_BUCKET=
S3_ENDPOINT_URL=
ENABLE_TRANSCODE=1

# Notifications
SENDGRID_API_KEY=
NOTIFY_EMAIL_FROM=alerts@example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Behaviour
PUBLISH_DEFAULT_TIMEZONE=UTC
RETRY_MAX_ATTEMPTS=5
RETRY_BACKOFF_BASE_SECONDS=30

# Caption variant engine (Claude). Without a key, the system falls back to a
# deterministic template-based variant.
ANTHROPIC_API_KEY=
ANTHROPIC_VARIANT_MODEL=claude-haiku-4-5-20251001

# Per-platform rate limit overrides (calls:window_seconds). Defaults are
# conservative and based on each platform's documented developer limits.
# RATE_LIMIT_FACEBOOK=200:3600
# RATE_LIMIT_INSTAGRAM=50:3600
# RATE_LIMIT_TIKTOK=30:86400
# RATE_LIMIT_YOUTUBE=6:86400

# Observability (both optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=
RELEASE_VERSION=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=social-distributor

# Magic-link auth (C3)
MAGIC_LINK_TTL=1800
SESSION_COOKIE_SECURE=0
DASHBOARD_URL=/
# Auto-seed me@local user when users table is empty (dev convenience). 0 to disable.
AUTO_SEED_USER=1
# HTTP timeout for platform API calls in seconds (default 60)
PLATFORM_HTTP_TIMEOUT=60
# nginx envsubst replaces this in frontend index.html / sw.js
API_BASE_URL=http://localhost:5000
CACHE_VERSION=dev
